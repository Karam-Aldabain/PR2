@baseUrl = http://localhost:3000
@todoId = {{createTodo.response.body.$.id}}

### Collection → expected 200
GET {{baseUrl}}/api/todos

> {%
  client.test("Collection", function () {
    client.assert(response.status === 200, "Expected 200");
    client.assert(Array.isArray(response.body), "Array");
  });
%}

### Create → expected 201
# @name createTodo
POST {{baseUrl}}/api/todos
Content-Type: application/json

{
  "title": "HTTP Test",
  "description": "REST prüfen",
  "priority": "hoch",
  "dueDate": "2027-12-31"
}

> {%
  client.test("Create", function () {
    client.assert(response.status === 201, "Expected 201");
    client.assert(!!response.body.id, "Generated ID");
    client.assert(response.headers.valueOf("Location") === "/api/todos/" + response.body.id, "Location");
    client.assert(response.body.status === "offen", "Initial status");
    client.global.set("todoId", response.body.id);
    client.global.set("original", JSON.stringify(response.body));
  });
%}

### Read created → expected 200
GET {{baseUrl}}/api/todos/{{todoId}}

> {%
  client.test("Read created", function () {
    client.assert(response.status === 200, "Expected 200");
    client.assert(JSON.stringify(response.body) === client.global.get("original"), "Created state");
  });
%}

### Replace → expected 200
PUT {{baseUrl}}/api/todos/{{todoId}}
Content-Type: application/json

{
  "title": "PUT",
  "description": "REST prüfen",
  "priority": "hoch",
  "dueDate": "2027-12-31",
  "status": "in Bearbeitung"
}

> {%
  client.test("Replace", function () {
    client.assert(response.status === 200, "Expected 200");
    const original = JSON.parse(client.global.get("original"));
    client.assert(response.body.id === original.id && response.body.createdAt === original.createdAt, "Immutable fields");
    client.assert(response.body.title === "PUT", "Replaced title");
    client.global.set("expected", JSON.stringify(response.body));
  });
%}

### Verify PUT → expected 200
GET {{baseUrl}}/api/todos/{{todoId}}

> {%
  client.test("Verify PUT", function () {
    client.assert(response.status === 200, "Expected 200");
    client.assert(JSON.stringify(response.body) === client.global.get("expected"), "Unchanged expected state");
  });
%}

### Status only → expected 200
PATCH {{baseUrl}}/api/todos/{{todoId}}
Content-Type: application/json

{
  "status": "erledigt"
}

> {%
  client.test("Status only", function () {
    client.assert(response.status === 200, "Expected 200");
    const expected = JSON.parse(client.global.get("expected")); expected.status = "erledigt";
    client.assert(JSON.stringify(response.body) === JSON.stringify(expected), "Only status changes");
    client.global.set("expected", JSON.stringify(response.body));
  });
%}

### Verify PATCH → expected 200
GET {{baseUrl}}/api/todos/{{todoId}}

> {%
  client.test("Verify PATCH", function () {
    client.assert(response.status === 200, "Expected 200");
    client.assert(JSON.stringify(response.body) === client.global.get("expected"), "Unchanged expected state");
  });
%}

### Remove due date → expected 200
PATCH {{baseUrl}}/api/todos/{{todoId}}
Content-Type: application/json

{
  "dueDate": null
}

> {%
  client.test("Remove due date", function () {
    client.assert(response.status === 200, "Expected 200");
    client.assert(response.body.dueDate === undefined, "Date removed");
    client.global.set("expected", JSON.stringify(response.body));
  });
%}

